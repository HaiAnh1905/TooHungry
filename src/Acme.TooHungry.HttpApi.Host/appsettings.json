{
  "App": {
    "SelfUrl": "https://localhost:44353",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.TooHungry.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=TooHungry;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44353",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "TooHungry_Swagger",
    "CertificatePassPhrase": "__CONFIGURE_VIA_ENV_OR_USER_SECRETS__"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "__CONFIGURE_VIA_ENV_OR_USER_SECRETS__"
  },
  "Cloudinary": {
    "CloudName": "toohungry-demo",
    "ApiKey": "",
    "ApiSecret": "",
    "UploadPreset": "toohungry_dishes"
  },
  "Settings": {
    "Abp.Account.IsSelfRegistrationEnabled": "false"
  }
}